rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(myPath()); }
    function me() { return get(myPath()); }
    function active() { return hasProfile() && (me().data.estado == 'activo' || me().data.estado == 'Activo'); }
    function admin() { return active() && me().data.role == 'admin'; }
    function positiveNumber(v) { return (v is int || v is float) && v >= 0; }
    function strictPositive(v) { return (v is int || v is float) && v > 0; }
    function nonNegativeInt(v) { return v is int && v >= 0; }
    function positiveInt(v) { return v is int && v > 0; }
    function validPayment(m) { return m in ['Efectivo','Yape','Plin','Tarjeta']; }
    function validPaymentPart(p) {
      return p is map
        && p.keys().hasOnly(['metodo','monto'])
        && validPayment(p.metodo)
        && strictPositive(p.monto);
    }
    function validSalePayments(d) {
      return d.pagos is list
        && (
          (d.pagos.size() == 1
            && validPaymentPart(d.pagos[0])
            && d.metodoPago == d.pagos[0].metodo
            && d.pagos[0].monto == d.total)
          ||
          (d.pagos.size() == 2
            && validPaymentPart(d.pagos[0])
            && validPaymentPart(d.pagos[1])
            && d.pagos[0].metodo != d.pagos[1].metodo
            && d.metodoPago == 'Pago separado'
            && d.pagos[0].monto + d.pagos[1].monto >= d.total - 0.011
            && d.pagos[0].monto + d.pagos[1].monto <= d.total + 0.011)
        );
    }
    function validDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function validTime(v) { return v is string && v.matches('^[0-9]{2}:[0-9]{2}:[0-9]{2}$'); }
    function shortText(v, maxLen) { return v is string && v.size() <= maxLen; }
    function validStatus(v) { return v in ['Activo','Inactivo']; }
    function cashPath(id) { return /databases/$(database)/documents/cashSessions/$(id); }
    function journeyPath(id) { return /databases/$(database)/documents/jornadas/$(id); }
    function lockPath(uid) { return /databases/$(database)/documents/cashLocks/$(uid); }

    // Autorización temporal para recrear documentos históricos inexistentes.
    // Solo administradores activos; no concede update/delete ni permisos a empleados.
    function restorationGrant() {
      return admin()
        && exists(/databases/$(database)/documents/restoreGrants/$(request.auth.uid))
        && get(/databases/$(database)/documents/restoreGrants/$(request.auth.uid)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/restoreGrants/$(request.auth.uid)).data.expiresAt > request.time;
    }
    // Bloqueo persistente de operaciones durante recuperación. No expira por cerrar la página.
    function maintenance() {
      return exists(/databases/$(database)/documents/system/restoreState)
        && get(/databases/$(database)/documents/system/restoreState).data.active == true;
    }
    function restorationWrite() {
      return maintenance() && restorationGrant() && request.method == 'create';
    }
    match /system/{id} {
      allow read: if active() && id == 'restoreState';
      allow create, update: if id == 'restoreState' && admin()
        && request.resource.data.keys().hasOnly(['active','backupId','ownerUid','updatedAt'])
        && request.resource.data.backupId is string
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.active is bool;
      allow delete: if false;
    }
    match /restoreGrants/{uid} {
      allow read: if admin() && uid == request.auth.uid;
      allow create, update: if admin() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid','backupId','expiresAt','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.backupId is string
        && request.resource.data.backupId.size() > 0
        && request.resource.data.backupId.size() <= 90
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(10, 'm')
        && request.resource.data.createdAt == request.time;
      allow delete: if admin() && uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if admin() || (active() && uid == request.auth.uid);
      allow create, update: if (!maintenance() || restorationWrite()) && (admin()
        && request.resource.data.keys().hasOnly(['email','role','nombres','apellidos','nombre','apellido','dni','telefono','estado'])
        && shortText(request.resource.data.email, 160)
        && request.resource.data.email.size() > 3
        && request.resource.data.role in ['admin','empleado']
        && shortText(request.resource.data.nombres, 100)
        && request.resource.data.nombres.size() > 0
        && shortText(request.resource.data.apellidos, 100)
        && request.resource.data.apellidos.size() > 0
        && shortText(request.resource.data.dni, 30)
        && shortText(request.resource.data.telefono, 40)
        && validStatus(request.resource.data.estado));
      allow delete: if (!maintenance() || restorationWrite()) && (admin() && uid != request.auth.uid);
    }

    match /categories/{id} {
      allow read: if active();
      allow create, update: if (!maintenance() || restorationWrite()) && (admin()
        && request.resource.data.keys().hasOnly(['nombre','estado'])
        && shortText(request.resource.data.nombre, 80)
        && request.resource.data.nombre.size() > 0
        && validStatus(request.resource.data.estado));
      allow delete: if (!maintenance() || restorationWrite()) && (admin());
    }
    match /deletedCategories/{id} {
      allow read: if admin();
      allow create, update, delete: if (!maintenance() || restorationWrite()) && (admin());
    }

    match /products/{id} {
      allow read: if active();
      allow create: if (!maintenance() || restorationWrite()) && (admin()
        && request.resource.data.keys().hasOnly(['nombre','categoriaId','precioCompra','precioVenta','stock','stockMinimo','descripcion','imagen','estado'])
        && shortText(request.resource.data.nombre, 160)
        && request.resource.data.nombre.size() > 0
        && shortText(request.resource.data.categoriaId, 80)
        && request.resource.data.categoriaId.size() > 0
        && positiveNumber(request.resource.data.precioCompra)
        && positiveNumber(request.resource.data.precioVenta)
        && nonNegativeInt(request.resource.data.stock)
        && nonNegativeInt(request.resource.data.stockMinimo)
        && shortText(request.resource.data.descripcion, 1000)
        && shortText(request.resource.data.imagen, 80)
        && validStatus(request.resource.data.estado));
      allow update: if (!maintenance() || restorationWrite()) && (admin() || (active()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && nonNegativeInt(request.resource.data.stock)
        && request.resource.data.stock < resource.data.stock));
      allow delete: if (!maintenance() || restorationWrite()) && (admin());
    }
    match /deletedProducts/{id} {
      allow read: if admin();
      allow create, update, delete: if (!maintenance() || restorationWrite()) && (admin());
    }

    // Una jornada representa un turno operativo y puede cruzar medianoche.
    match /jornadas/{id} {
      allow read: if admin() || (active() && resource.data.usuarioId == request.auth.uid);
      allow create: if (!maintenance() || restorationWrite()) && (active()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.cajaId == id
        && request.resource.data.numero is string
        && request.resource.data.numero.matches('^JOR-[A-Z0-9]{1,12}$')
        && validDate(request.resource.data.fechaApertura)
        && validTime(request.resource.data.horaApertura)
        && shortText(request.resource.data.usuarioNombre, 220)
        && request.resource.data.estado == 'Abierta'
        && positiveNumber(request.resource.data.montoInicial)
        && request.resource.data.createdAt is timestamp
        && (
          (exists(cashPath(id)) && get(cashPath(id)).data.usuarioId == request.auth.uid && get(cashPath(id)).data.estado == 'Abierta')
          ||
          (getAfter(cashPath(id)).data.usuarioId == request.auth.uid && getAfter(cashPath(id)).data.estado == 'Abierta')
        ) || (restorationGrant() && request.resource.data is map && request.resource.data.keys().size() > 0));
      allow update: if (!maintenance() || restorationWrite()) && ((
        ((admin() || (active() && resource.data.usuarioId == request.auth.uid))
          && resource.data.estado == 'Abierta'
          && request.resource.data.estado == 'Cerrada'
          && request.resource.data.usuarioId == resource.data.usuarioId
          && request.resource.data.cajaId == resource.data.cajaId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado','fechaCierre','horaCierre','duracionMinutos','totalVentas','cantidadVentas','totalGastos',
            'efectivoVentas','yapeVentas','plinVentas','tarjetaVentas','ingresosEfectivo','retirosEfectivo','gastosEfectivo',
            'efectivoEsperado','efectivoReal','diferencia','empleadoIds','empleadoNombres','closedAt'
          ]))
        ||
        (admin()
          && resource.data.estado == 'Cerrada'
          && request.resource.data.estado == 'Cerrada'
          && request.resource.data.usuarioId == resource.data.usuarioId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'totalVentas','cantidadVentas','totalGastos','efectivoVentas','yapeVentas','plinVentas','tarjetaVentas','gastosEfectivo','efectivoEsperado','diferencia',
            'ajustePorAnulacion','ultimaAnulacionId','ultimaAnulacionFecha','ultimaAnulacionHora','ajustePorGasto','ultimoGastoAjustadoId'
          ]))
      ));
      allow delete: if (!maintenance() || restorationWrite()) && (admin());
    }

    match /sales/{id} {
      allow read: if admin() || (active() && resource.data.empleadoId == request.auth.uid);
      allow create: if (!maintenance() || restorationWrite()) && (active()
        && request.resource.data.keys().hasOnly(['fecha','hora','numero','empleadoId','empleadoNombre','cajaId','jornadaId','items','total','costoTotal','metodoPago','pagos','estado','createdAt'])
        && request.resource.data.empleadoId == request.auth.uid
        && request.resource.data.numero is string
        && request.resource.data.numero.matches('^V-[A-Z0-9]{6}$')
        && validDate(request.resource.data.fecha)
        && validTime(request.resource.data.hora)
        && shortText(request.resource.data.empleadoNombre, 220)
        && request.resource.data.empleadoNombre.size() > 0
        && request.resource.data.cajaId is string
        && request.resource.data.jornadaId is string
        && request.resource.data.cajaId == request.resource.data.jornadaId
        && exists(cashPath(request.resource.data.cajaId))
        && get(cashPath(request.resource.data.cajaId)).data.usuarioId == request.auth.uid
        && get(cashPath(request.resource.data.cajaId)).data.estado == 'Abierta'
        && exists(journeyPath(request.resource.data.jornadaId))
        && get(journeyPath(request.resource.data.jornadaId)).data.usuarioId == request.auth.uid
        && get(journeyPath(request.resource.data.jornadaId)).data.estado == 'Abierta'
        && exists(lockPath(request.auth.uid))
        && get(lockPath(request.auth.uid)).data.cajaId == request.resource.data.cajaId
        && request.resource.data.estado == 'Completada'
        && validSalePayments(request.resource.data)
        && strictPositive(request.resource.data.total)
        && positiveNumber(request.resource.data.costoTotal)
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.createdAt is timestamp || (restorationGrant() && request.resource.data is map && request.resource.data.keys().size() > 0));
      allow update: if (!maintenance() || restorationWrite()) && (admin());
      allow delete: if (!maintenance() || restorationWrite()) && (admin());
    }

    match /movements/{id} {
      allow read: if admin();
      allow create: if (!maintenance() || restorationWrite()) && (admin() || (active()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.tipo == 'Venta'
        && validDate(request.resource.data.fecha)
        && validTime(request.resource.data.hora)
        && request.resource.data.jornadaId is string
        && request.resource.data.cajaId == request.resource.data.jornadaId
        && get(journeyPath(request.resource.data.jornadaId)).data.usuarioId == request.auth.uid
        && get(journeyPath(request.resource.data.jornadaId)).data.estado == 'Abierta'
        && shortText(request.resource.data.productoId, 120)
        && request.resource.data.productoId.size() > 0
        && shortText(request.resource.data.productoNombre, 160)
        && positiveInt(request.resource.data.cantidad)
        && nonNegativeInt(request.resource.data.stockAnterior)
        && nonNegativeInt(request.resource.data.stockNuevo)
        && request.resource.data.stockNuevo < request.resource.data.stockAnterior
        && request.resource.data.stockAnterior - request.resource.data.stockNuevo == request.resource.data.cantidad
        && shortText(request.resource.data.motivo, 300)) || (restorationGrant() && request.resource.data is map && request.resource.data.keys().size() > 0));
      allow update: if (!maintenance() || restorationWrite()) && (false);
      allow delete: if (!maintenance() || restorationWrite()) && (admin());
    }

    // Los gastos manuales y automáticos siguen siendo administrados por el administrador.
    match /expenses/{id} {
      allow read: if admin() || (active() && resource.data.jornadaId is string && exists(journeyPath(resource.data.jornadaId)) && get(journeyPath(resource.data.jornadaId)).data.usuarioId == request.auth.uid);
      allow create, update, delete: if (!maintenance() || restorationWrite()) && (admin());
    }
    match /deletedExpenses/{id} {
      allow read: if admin();
      allow create: if (!maintenance() || restorationWrite()) && (admin());
      allow update, delete: if (!maintenance() || restorationWrite()) && (false);
    }
    match /expenseRevisions/{id} {
      allow read: if admin();
      allow create: if (!maintenance() || restorationWrite()) && (admin());
      allow update, delete: if (!maintenance() || restorationWrite()) && (false);
    }

    // Ingresos/retiros físicos durante una jornada. No son ventas.
    match /cashMovements/{id} {
      allow read: if admin() || (active() && resource.data.usuarioId == request.auth.uid);
      allow create: if (!maintenance() || restorationWrite()) && (active()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.tipo in ['Ingreso','Retiro']
        && strictPositive(request.resource.data.monto)
        && shortText(request.resource.data.concepto, 160)
        && request.resource.data.concepto.size() > 0
        && validDate(request.resource.data.fecha)
        && validTime(request.resource.data.hora)
        && request.resource.data.jornadaId is string
        && request.resource.data.cajaId == request.resource.data.jornadaId
        && exists(journeyPath(request.resource.data.jornadaId))
        && get(journeyPath(request.resource.data.jornadaId)).data.usuarioId == request.auth.uid
        && get(journeyPath(request.resource.data.jornadaId)).data.estado == 'Abierta'
        && exists(cashPath(request.resource.data.cajaId))
        && get(cashPath(request.resource.data.cajaId)).data.estado == 'Abierta'
        && request.resource.data.createdAt is timestamp || (restorationGrant() && request.resource.data is map && request.resource.data.keys().size() > 0));
      allow update: if (!maintenance() || restorationWrite()) && (false);
      allow delete: if (!maintenance() || restorationWrite()) && (admin());
    }

    match /cashLocks/{uid} {
      allow read: if admin() || (active() && uid == request.auth.uid);
      allow create: if (!maintenance() || restorationWrite()) && (active()
        && uid == request.auth.uid
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.cajaId is string
        && request.resource.data.jornadaId == request.resource.data.cajaId
        && request.resource.data.estado == 'Abierta'
        && validDate(request.resource.data.fecha)
        && validTime(request.resource.data.hora)
        && getAfter(cashPath(request.resource.data.cajaId)).data.usuarioId == request.auth.uid
        && getAfter(cashPath(request.resource.data.cajaId)).data.estado == 'Abierta'
        && getAfter(journeyPath(request.resource.data.jornadaId)).data.usuarioId == request.auth.uid
        && getAfter(journeyPath(request.resource.data.jornadaId)).data.estado == 'Abierta');
      allow update: if (!maintenance() || restorationWrite()) && (admin() || (active()
        && uid == request.auth.uid
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.cajaId is string
        && request.resource.data.jornadaId == request.resource.data.cajaId
        && request.resource.data.estado == 'Abierta'
        && validDate(request.resource.data.fecha)
        && validTime(request.resource.data.hora)
        && (!exists(cashPath(resource.data.cajaId)) || get(cashPath(resource.data.cajaId)).data.estado != 'Abierta')
        && getAfter(cashPath(request.resource.data.cajaId)).data.usuarioId == request.auth.uid
        && getAfter(cashPath(request.resource.data.cajaId)).data.estado == 'Abierta'
        && getAfter(journeyPath(request.resource.data.jornadaId)).data.estado == 'Abierta'));
      allow delete: if (!maintenance() || restorationWrite()) && (admin() || (active()
        && uid == request.auth.uid
        && resource.data.usuarioId == request.auth.uid
        && resource.data.cajaId is string
        && getAfter(cashPath(resource.data.cajaId)).data.estado == 'Cerrada'));
    }

    match /cashSessions/{id} {
      allow read: if admin() || (active() && resource.data.usuarioId == request.auth.uid);
      allow create: if (!maintenance() || restorationWrite()) && (active()
        && request.resource.data.keys().hasOnly(['fecha','hora','usuarioId','usuarioNombre','montoInicial','jornadaId','estado','createdAt'])
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.jornadaId == id
        && shortText(request.resource.data.usuarioNombre, 220)
        && validDate(request.resource.data.fecha)
        && validTime(request.resource.data.hora)
        && request.resource.data.estado == 'Abierta'
        && positiveNumber(request.resource.data.montoInicial)
        && request.resource.data.createdAt is timestamp
        && getAfter(lockPath(request.auth.uid)).data.cajaId == id
        && getAfter(lockPath(request.auth.uid)).data.jornadaId == id
        && getAfter(lockPath(request.auth.uid)).data.estado == 'Abierta'
        && getAfter(journeyPath(id)).data.usuarioId == request.auth.uid
        && getAfter(journeyPath(id)).data.estado == 'Abierta' || (restorationGrant() && request.resource.data is map && request.resource.data.keys().size() > 0));
      allow update: if (!maintenance() || restorationWrite()) && ((
        ((admin() || (active() && resource.data.usuarioId == request.auth.uid))
          && request.resource.data.usuarioId == resource.data.usuarioId
          && resource.data.estado == 'Abierta'
          && request.resource.data.estado == 'Cerrada'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado','fechaCierre','horaCierre','totalVentasDia','cantidadVentasDia','efectivoVentas','yapeVentas','plinVentas','tarjetaVentas',
            'ingresosEfectivo','retirosEfectivo','gastosEfectivo','esperado','real','diferencia','closedAt'
          ]))
        ||
        (admin()
          && resource.data.estado == 'Cerrada'
          && request.resource.data.estado == 'Cerrada'
          && request.resource.data.usuarioId == resource.data.usuarioId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'totalVentasDia','cantidadVentasDia','efectivoVentas','yapeVentas','plinVentas','tarjetaVentas','gastosEfectivo','esperado','diferencia',
            'ajustePorAnulacion','ultimaAnulacionId','ultimaAnulacionFecha','ultimaAnulacionHora','ajustePorGasto','ultimoGastoAjustadoId'
          ]))
      ));
      allow delete: if (!maintenance() || restorationWrite()) && (admin());
    }

    match /audits/{id} {
      allow read: if admin();
      allow create: if (!maintenance() || restorationWrite()) && (active()
        && request.resource.data.usuarioId == request.auth.uid
        && validDate(request.resource.data.fecha)
        && validTime(request.resource.data.hora)
        && shortText(request.resource.data.accion, 120)
        && shortText(request.resource.data.detalle, 1000)
        && shortText(request.resource.data.usuarioNombre, 220)
        && request.resource.data.createdAt is timestamp || (restorationGrant() && request.resource.data is map && request.resource.data.keys().size() > 0));
      allow update: if (!maintenance() || restorationWrite()) && (false);
      allow delete: if (!maintenance() || restorationWrite()) && (admin());
    }

    match /{document=**} { allow read, write: if false; }
  }
}
