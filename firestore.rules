rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(myPath()); }
    function me() { return get(myPath()); }
    function active() { return hasProfile() && (me().data.estado == 'activo' || me().data.estado == 'Activo'); }
    function admin() { return active() && me().data.role == 'admin'; }
    function validPayment(m) { return m in ['Efectivo','Yape','Plin','Tarjeta']; }
    function positiveNumber(v) { return (v is int || v is float) && v >= 0; }
    function strictPositive(v) { return (v is int || v is float) && v > 0; }
    function nonNegativeInt(v) { return v is int && v >= 0; }
    function positiveInt(v) { return v is int && v > 0; }
    function validDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function validTime(v) { return v is string && v.matches('^[0-9]{2}:[0-9]{2}:[0-9]{2}$'); }
    function shortText(v, maxLen) { return v is string && v.size() <= maxLen; }
    function validStatus(v) { return v in ['Activo','Inactivo']; }

    match /users/{uid} {
      allow read: if admin() || (active() && uid == request.auth.uid);
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['email','role','nombres','apellidos','nombre','apellido','dni','telefono','estado'])
        && shortText(request.resource.data.email, 160)
        && request.resource.data.email.size() > 3
        && request.resource.data.role in ['admin','empleado']
        && shortText(request.resource.data.nombres, 100)
        && request.resource.data.nombres.size() > 0
        && shortText(request.resource.data.apellidos, 100)
        && request.resource.data.apellidos.size() > 0
        && shortText(request.resource.data.dni, 30)
        && shortText(request.resource.data.telefono, 40)
        && validStatus(request.resource.data.estado);
      // v31: el administrador puede borrar perfiles de empleados durante el reinicio, nunca el suyo.
      allow delete: if admin() && uid != request.auth.uid;
    }
    match /categories/{id} {
      allow read: if active();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['nombre','estado'])
        && shortText(request.resource.data.nombre, 80)
        && request.resource.data.nombre.size() > 0
        && validStatus(request.resource.data.estado);
      allow delete: if admin();
    }
    match /deletedCategories/{id} {
      // Archivo técnico: la categoría desaparece del catálogo, pero queda una copia
      // para conservar trazabilidad de eliminaciones administrativas.
      allow read, create, update: if admin();
      allow delete: if admin();
    }
    match /products/{id} {
      allow read: if active();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['nombre','categoriaId','precioCompra','precioVenta','stock','stockMinimo','descripcion','imagen','estado'])
        && shortText(request.resource.data.nombre, 160)
        && request.resource.data.nombre.size() > 0
        && shortText(request.resource.data.categoriaId, 80)
        && request.resource.data.categoriaId.size() > 0
        && positiveNumber(request.resource.data.precioCompra)
        && positiveNumber(request.resource.data.precioVenta)
        && nonNegativeInt(request.resource.data.stock)
        && nonNegativeInt(request.resource.data.stockMinimo)
        && shortText(request.resource.data.descripcion, 1000)
        && shortText(request.resource.data.imagen, 80)
        && validStatus(request.resource.data.estado);
      // Admin administra catálogo. Empleado solo puede reducir stock; nunca aumentarlo
      // ni modificar precios/nombre/categoría desde el cliente.
      allow update: if admin() || (active()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && nonNegativeInt(request.resource.data.stock)
        && request.resource.data.stock < resource.data.stock);
      allow delete: if admin();
    }
    match /deletedProducts/{id} {
      // Los productos eliminados salen de /products y no vuelven a ventas/inventario.
      // El archivo permite mantener integridad si después se anula una venta histórica.
      allow read, create, update: if admin();
      allow delete: if admin();
    }
    match /sales/{id} {
      allow read: if admin() || (active() && resource.data.empleadoId == request.auth.uid);
      allow create: if active()
        && request.resource.data.keys().hasOnly(['fecha','hora','numero','empleadoId','empleadoNombre','cajaId','items','total','costoTotal','metodoPago','estado','createdAt'])
        && request.resource.data.empleadoId == request.auth.uid
        && request.resource.data.numero is string
        && request.resource.data.numero.matches('^V-[A-Z0-9]{6}$')
        && validDate(request.resource.data.fecha)
        && validTime(request.resource.data.hora)
        && shortText(request.resource.data.empleadoNombre, 220)
        && request.resource.data.empleadoNombre.size() > 0
        && shortText(request.resource.data.cajaId, 120)
        && request.resource.data.cajaId.size() > 0
        && exists(/databases/$(database)/documents/cashSessions/$(request.resource.data.cajaId))
        && get(/databases/$(database)/documents/cashSessions/$(request.resource.data.cajaId)).data.usuarioId == request.auth.uid
        && get(/databases/$(database)/documents/cashSessions/$(request.resource.data.cajaId)).data.estado == 'Abierta'
        && get(/databases/$(database)/documents/cashSessions/$(request.resource.data.cajaId)).data.fecha == request.resource.data.fecha
        && exists(/databases/$(database)/documents/cashLocks/$(request.auth.uid))
        && get(/databases/$(database)/documents/cashLocks/$(request.auth.uid)).data.cajaId == request.resource.data.cajaId
        && request.resource.data.estado == 'Completada'
        && validPayment(request.resource.data.metodoPago)
        && strictPositive(request.resource.data.total)
        && positiveNumber(request.resource.data.costoTotal)
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.createdAt is timestamp;
      allow update: if admin();
      allow delete: if admin();
    }
    match /movements/{id} {
      allow read: if admin();
      allow create: if admin() || (active()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.tipo == 'Venta'
        && validDate(request.resource.data.fecha)
        && validTime(request.resource.data.hora)
        && shortText(request.resource.data.productoId, 120)
        && request.resource.data.productoId.size() > 0
        && shortText(request.resource.data.productoNombre, 160)
        && positiveInt(request.resource.data.cantidad)
        && nonNegativeInt(request.resource.data.stockAnterior)
        && nonNegativeInt(request.resource.data.stockNuevo)
        && request.resource.data.stockNuevo < request.resource.data.stockAnterior
        && request.resource.data.stockAnterior - request.resource.data.stockNuevo == request.resource.data.cantidad
        && shortText(request.resource.data.motivo, 300));
      allow update: if false;
      allow delete: if admin();
    }
    match /expenses/{id} {
      allow read, create, update, delete: if admin();
    }
    match /cashLocks/{uid} {
      allow read: if admin() || (active() && uid == request.auth.uid);
      allow create: if active()
        && uid == request.auth.uid
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.cajaId is string
        && request.resource.data.cajaId.size() > 0
        && request.resource.data.estado == 'Abierta'
        && validDate(request.resource.data.fecha)
        && validTime(request.resource.data.hora)
        && getAfter(/databases/$(database)/documents/cashSessions/$(request.resource.data.cajaId)).data.usuarioId == request.auth.uid
        && getAfter(/databases/$(database)/documents/cashSessions/$(request.resource.data.cajaId)).data.estado == 'Abierta';
      allow update: if admin() || (active()
        && uid == request.auth.uid
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.cajaId is string
        && request.resource.data.cajaId.size() > 0
        && request.resource.data.estado == 'Abierta'
        && validDate(request.resource.data.fecha)
        && validTime(request.resource.data.hora)
        && (!exists(/databases/$(database)/documents/cashSessions/$(resource.data.cajaId))
          || get(/databases/$(database)/documents/cashSessions/$(resource.data.cajaId)).data.estado != 'Abierta')
        && getAfter(/databases/$(database)/documents/cashSessions/$(request.resource.data.cajaId)).data.usuarioId == request.auth.uid
        && getAfter(/databases/$(database)/documents/cashSessions/$(request.resource.data.cajaId)).data.estado == 'Abierta');
      allow delete: if admin() || (active()
        && uid == request.auth.uid
        && resource.data.usuarioId == request.auth.uid
        && resource.data.cajaId is string
        && getAfter(/databases/$(database)/documents/cashSessions/$(resource.data.cajaId)).data.estado == 'Cerrada');
    }
    match /cashSessions/{id} {
      allow read: if admin() || (active() && resource.data.usuarioId == request.auth.uid);
      allow create: if active()
        && request.resource.data.keys().hasOnly(['fecha','hora','usuarioId','usuarioNombre','montoInicial','estado','createdAt'])
        && request.resource.data.usuarioId == request.auth.uid
        && shortText(request.resource.data.usuarioNombre, 220)
        && validDate(request.resource.data.fecha)
        && validTime(request.resource.data.hora)
        && request.resource.data.estado == 'Abierta'
        && positiveNumber(request.resource.data.montoInicial)
        && request.resource.data.createdAt is timestamp
        && getAfter(/databases/$(database)/documents/cashLocks/$(request.auth.uid)).data.cajaId == id
        && getAfter(/databases/$(database)/documents/cashLocks/$(request.auth.uid)).data.estado == 'Abierta';
      // Nadie puede reutilizar una caja existente para volver a "abrirla".
      // Admin y propietario solo pueden realizar la transición Abierta -> Cerrada.
      allow update: if (
        // Cierre normal: propietario o admin, Abierta -> Cerrada.
        ((admin() || (active() && resource.data.usuarioId == request.auth.uid))
          && request.resource.data.usuarioId == resource.data.usuarioId
          && resource.data.estado == 'Abierta'
          && request.resource.data.estado == 'Cerrada'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','fechaCierre','horaCierre','totalVentasDia','cantidadVentasDia','efectivoVentas','yapeVentas','plinVentas','tarjetaVentas','esperado','real','diferencia','closedAt']))
        ||
        // Ajuste de una caja cerrada únicamente por Admin al anular una venta.
        (admin()
          && resource.data.estado == 'Cerrada'
          && request.resource.data.estado == 'Cerrada'
          && request.resource.data.usuarioId == resource.data.usuarioId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVentasDia','cantidadVentasDia','efectivoVentas','yapeVentas','plinVentas','tarjetaVentas','esperado','diferencia','ajustePorAnulacion','ultimaAnulacionId','ultimaAnulacionFecha','ultimaAnulacionHora']))
      );
      allow delete: if admin();
    }
    match /audits/{id} {
      allow read: if admin();
      allow create: if active()
        && request.resource.data.usuarioId == request.auth.uid
        && validDate(request.resource.data.fecha)
        && validTime(request.resource.data.hora)
        && shortText(request.resource.data.accion, 120)
        && shortText(request.resource.data.detalle, 1000)
        && shortText(request.resource.data.usuarioNombre, 220)
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
